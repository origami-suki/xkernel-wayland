#!/bin/sh
set -eu
[ "$(id -u)" = 1000 ] || { echo 'wayland-browser: run as kiosk' >&2; exit 1; }
export XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-0
# Sandbox/GPU changes, if required by a reproduced failure, are explicit caller arguments.
exec /usr/bin/chromium --ozone-platform=wayland \
  --user-data-dir=/home/kiosk/.config/chromium-wayland \
  --no-first-run --no-default-browser-check "$@" file:///opt/ict-testpages/index.html
